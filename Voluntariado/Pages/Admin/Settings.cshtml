@page
@model Voluntariado.Pages.Admin.SettingsModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Configuración de Cuenta";
}

<div class="container mt-4">
    <h2 class="fw-bold mb-4">⚙️ Configuración de Cuenta</h2>

    <form method="post" class="card shadow-sm p-4">

        <div class="mb-3">
            <label class="form-label">Nombre completo</label>
            <input type="text" class="form-control" asp-for="Nombre" />
        </div>

        <div class="mb-3">
            <label class="form-label">Correo electrónico</label>
            <input type="email" class="form-control" asp-for="Correo" />
        </div>

        <div class="mb-3">
            <label class="form-label">Nueva contraseña (opcional)</label>
            <input type="password" class="form-control" asp-for="Password" />
        </div>

        <button type="submit" class="btn btn-primary w-100">Guardar Cambios</button>

    </form>

</div>
