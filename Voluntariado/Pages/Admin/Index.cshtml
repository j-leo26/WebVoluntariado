@page
@model Voluntariado.Pages.Admin.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Panel de Administración";
}

<div class="container mt-5">

    <h1 class="mb-4 text-center fw-bold">📊 Panel de Administración</h1>
    <p class="text-center mb-5">Administra usuarios, roles y ofertas desde un panel centralizado.</p>

    <!-- Tarjetas principales -->
    <div class="row g-4">

        <div class="col-md-4">
            <a asp-page="/Users/Index" class="text-decoration-none">
                <div class="card shadow h-100 admin-card">
                    <div class="card-body text-center">
                        <h3 class="card-title"> Usuarios</h3>
                        <p class="card-text">Gestiona todos los usuarios activos del sistema.</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-4">
            <a asp-page="/Roles/Index" class="text-decoration-none">
                <div class="card shadow h-100 admin-card">
                    <div class="card-body text-center">
                        <h3 class="card-title"> Roles</h3>
                        <p class="card-text">Configura y asigna roles personalizados.</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-4">
            <a asp-page="/Ofertas/Index" class="text-decoration-none">
                <div class="card shadow h-100 admin-card">
                    <div class="card-body text-center">
                        <h3 class="card-title"> Ofertas</h3>
                        <p class="card-text">Administra las ofertas de voluntariado publicadas.</p>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- ESTADÍSTICAS Y GRÁFICAS -->
    <div class="card shadow mt-5">
        <div class="card-body">
            <h4 class="fw-bold mb-4">📈 Estadísticas del Sistema</h4>

            <div class="row g-4">

                <!-- ACTIVIDAD DIARIA -->
                <div class="col-md-6">
                    <div class="card shadow-sm p-3">
                        <h5 class="text-center">Actividad diaria de usuarios</h5>
                        <canvas id="chartActividad"></canvas>
                    </div>
                </div>

                <!-- USUARIOS NUEVOS -->
                <div class="col-md-6">
                    <div class="card shadow-sm p-3">
                        <h5 class="text-center">Nuevos usuarios por mes</h5>
                        <canvas id="chartUsuarios"></canvas>
                    </div>
                </div>

                <!-- OFERTAS POPULARES -->
                <div class="col-md-6">
                    <div class="card shadow-sm p-3">
                        <h5 class="text-center">Ofertas más populares</h5>
                        <canvas id="chartOfertas"></canvas>
                    </div>
                </div>

                <!-- EXTRA: DISTRIBUCIÓN DE ROLES -->
                <div class="col-md-6">
                    <div class="card shadow-sm p-3">
                        <h5 class="text-center">Distribución de roles</h5>
                        <canvas id="chartRoles"></canvas>
                    </div>
                </div>

            </div>

        </div>
    </div>


    <!-- CHART.JS -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        // ===== ACTIVIDAD DIARIA =====
        new Chart(document.getElementById("chartActividad"), {
            type: "line",
            data: {
                labels: ["Lun", "Mar", "Mié", "Jue", "Vie", "Sáb", "Dom"],
                datasets: [{
                    label: "Actividad",
                    data: [120, 150, 180, 220, 200, 170, 140],
                    borderWidth: 2,
                    tension: 0.3
                }]
            }
        });

        // ===== USUARIOS NUEVOS =====
        new Chart(document.getElementById("chartUsuarios"), {
            type: "bar",
            data: {
                labels: ["Ene", "Feb", "Mar", "Abr", "May", "Jun"],
                datasets: [{
                    label: "Nuevos usuarios",
                    data: [20, 35, 40, 55, 48, 60],
                    borderWidth: 1
                }]
            }
        });

        // ===== OFERTAS POPULARES =====
        new Chart(document.getElementById("chartOfertas"), {
            type: "bar",
            data: {
                labels: ["Eco ONG", "Comedor Social", "Biblioteca", "Animales", "Escuela"],
                datasets: [{
                    label: "Voluntarios inscritos",
                    data: [90, 70, 55, 120, 40],
                    borderWidth: 1
                }]
            }
        });

        // ===== DISTRIBUCIÓN DE ROLES =====
        new Chart(document.getElementById("chartRoles"), {
            type: "doughnut",
            data: {
                labels: ["Admins", "Ofertantes", "Voluntarios"],
                datasets: [{
                    label: "Cantidad",
                    data: [3, 15, 87],
                    borderWidth: 1
                }]
            }
        });
    </script>



</div>

<style>
    .admin-card {
        transition: all .2s ease;
        border-radius: 12px;
    }

        .admin-card:hover {
            transform: translateY(-5px);
            background: #f5f5f5;
        }
</style>
