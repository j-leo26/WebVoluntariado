@page
@model Voluntariado.Pages.Info.AboutModel
@{
    ViewData["Title"] = "About";
}



<section class="py-5 bg-light">
    <div class="container">
        <h1 class="display-5 fw-bold text-center mb-4">About</h1>

        <div class="row align-items-center">

            <div class="col-md-6">
                <h1 class="display-5 fw-bold mb-3">Sobre Nosotros</h1>
                <p class="lead">
                    Somos una plataforma diseñada para conectar voluntarios con organizaciones
                    que buscan apoyo para proyectos sociales, ambientales, culturales y comunitarios.
                </p>

                <p class="lead">
                    Nuestro objetivo es facilitar la gestión del voluntariado, promover la participación social
                    y brindar herramientas digitales que hagan más fácil conectar a quienes desean ayudar
                    con quienes necesitan apoyo.
                </p>

                <a class="btn btn-primary btn-lg mt-3" asp-page="/Contact">Contáctanos</a>
            </div>

            <div class="col-md-6 text-center">
                <img src="https://cdn-icons-png.flaticon.com/512/4208/4208394.png"
                     class="img-fluid" style="max-width: 70%;" alt="Voluntariado">
            </div>

        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <h2 class="text-center fw-bold mb-4">Nuestros Valores</h2>

        <div class="row gy-4">

            <div class="col-md-4 text-center">
                <div class="p-4 border rounded shadow-sm h-100">
                    <h4 class="fw-bold">Solidaridad</h4>
                    <p>Promovemos el apoyo mutuo y la ayuda desinteresada.</p>
                </div>
            </div>

            <div class="col-md-4 text-center">
                <div class="p-4 border rounded shadow-sm h-100">
                    <h4 class="fw-bold">Compromiso</h4>
                    <p>Buscamos que cada voluntario tenga una experiencia significativa.</p>
                </div>
            </div>

            <div class="col-md-4 text-center">
                <div class="p-4 border rounded shadow-sm h-100">
                    <h4 class="fw-bold">Inclusión</h4>
                    <p>Fomentamos espacios en los que todos puedan participar.</p>
                </div>
            </div>

        </div>
    </div>
</section>
