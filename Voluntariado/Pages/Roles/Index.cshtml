@page
@model Voluntariado.Pages.Roles.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Roles";
}

<div class="container mt-4">

    <!-- Mensajes -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger shadow-sm">
            <i class="fa-solid fa-circle-exclamation"></i> @TempData["ErrorMessage"]
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success shadow-sm">
            <i class="fa-solid fa-circle-check"></i> @TempData["SuccessMessage"]
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold">
            <i class="fa-solid fa-id-badge"></i> Gestión de Roles
        </h1>

        <a asp-page="Create" class="btn btn-primary shadow-sm">
            <i class="fa-solid fa-plus"></i> Nuevo Rol
        </a>
    </div>

    <!-- Tabla -->
    <div class="card shadow border-0">
        <div class="card-body p-0">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.Roles)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Name</td>

                            <td class="text-center">
                                <a asp-page="Edit" asp-route-id="@item.Id"
                                   class="btn btn-warning btn-sm me-1">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>

                                <a asp-page="Details" asp-route-id="@item.Id"
                                   class="btn btn-info btn-sm me-1 text-white">
                                    <i class="fa-solid fa-circle-info"></i>
                                </a>

                                <a asp-page="Delete" asp-route-id="@item.Id"
                                   class="btn btn-danger btn-sm">
                                    <i class="fa-solid fa-trash"></i>
                                </a>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
