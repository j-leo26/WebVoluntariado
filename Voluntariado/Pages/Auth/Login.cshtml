@page
@model Voluntariado.Pages.Auth.LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card shadow p-4" style="max-width: 420px; width: 100%; border-radius: 15px;">
        <h3 class="text-center mb-4 fw-bold">Iniciar sesión</h3>

        @if (!string.IsNullOrEmpty(Model.Mensaje))
        {
            <div class="alert alert-warning text-center" role="alert">
                ⚠️ @Model.Mensaje
            </div>
        }

        <form method="post">
            <div class="mb-3">
                <label class="form-label">Correo o usuario</label>
                <input asp-for="Email" class="form-control form-control-lg" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Contraseña</label>
                <input asp-for="Password" type="password" class="form-control form-control-lg" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 btn-lg mt-3" style="border-radius: 10px;">
                Entrar
            </button>
        </form>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger mt-3">@TempData["ErrorMessage"]</div>
        }
        @if (TempData["DebugRole"] != null)
        {
            <div class="alert alert-info mt-3">@TempData["DebugRole"]</div>
        }

        <div class="text-center mt-3">
            <a href="/Auth/Register" class="text-decoration-none">¿No tienes cuenta? Regístrate</a>
        </div>
    </div>
</div>
