@page
@model Voluntariado.Pages.VolunteerOffers.CreateModel
@{
    ViewData["Title"] = "Crear Oferta";
}

<h2>Crear Nueva Oferta</h2>

<form method="post">
    <div class="form-group">
        <label for="Title">Título</label>
        <input asp-for="Offer.Title" class="form-control" />
        <span asp-validation-for="Offer.Title" class="text-danger"></span>
    </div>

    <div class="form-group mt-3">
        <label for="Description">Descripción</label>
        <textarea asp-for="Offer.Description" class="form-control"></textarea>
        <span asp-validation-for="Offer.Description" class="text-danger"></span>
    </div>

    <div class="form-group mt-3">
        <label for="EmailContact">Correo de Contacto</label>
        <input asp-for="Offer.EmailContact" type="email" class="form-control" />
        <span asp-validation-for="Offer.EmailContact" class="text-danger"></span>
    </div>

    <div class="form-group mt-3">
        <label for="TotalSpots">Número total de cupos</label>
        <input asp-for="Offer.TotalSpots" type="number" class="form-control" min="1" />
        <span asp-validation-for="Offer.TotalSpots" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success mt-3">Guardar</button>
    <a asp-page="Index" class="btn btn-secondary mt-3">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
