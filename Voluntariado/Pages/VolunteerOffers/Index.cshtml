@page
@model Voluntariado.Pages.VolunteerOffers.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Panel de Voluntario";
}

<section class="container py-5">
    <h2 class="fw-bold mb-4">Bienvenido Voluntario 👋</h2>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Ofertas Disponibles</h5>
                    <p class="card-text">Explora oportunidades de voluntariado cercanas a ti.</p>
                    <a asp-page="/VolunteerOffers/Index" class="btn btn-primary w-100">Ver Ofertas</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Mis Postulaciones</h5>
                    <p class="card-text">Consulta el estado de tus solicitudes.</p>
                    <a asp-page="/Users/Applications" class="btn btn-outline-primary w-100">Ver Estado</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Recomendaciones</h5>
                    <p class="card-text">Proyectos sugeridos según tu perfil.</p>
                    <a asp-page="/Users/Recommendations" class="btn btn-outline-primary w-100">Ver Recomendaciones</a>
                </div>
            </div>
        </div>

    </div>
</section>


